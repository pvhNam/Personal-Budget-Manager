<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background" android:id="@+id/scene_root">
    <vn.sotay.thuchi.GlassBackdrop android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/glass_backdrop" />
    <FrameLayout android:id="@+id/shell" android:layout_width="match_parent" android:layout_height="match_parent">
        <ScrollView android:id="@+id/content_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="94dp" android:scrollbars="none">
            <FrameLayout android:id="@+id/screen_host" android:layout_width="match_parent" android:layout_height="wrap_content">
                <include layout="@layout/screen_summary" />
            </FrameLayout>
        </ScrollView>
        <vn.sotay.thuchi.BlurExcludedLayout android:id="@+id/nav_panel" android:layout_width="match_parent" android:layout_height="72dp" android:layout_gravity="bottom" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:elevation="6dp">
            <vn.sotay.thuchi.MenuBlur android:id="@+id/menu_blur" android:layout_width="match_parent" android:layout_height="match_parent" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_menu" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp">
                <TextView style="@style/NavItem" android:id="@+id/nav_home" android:text="@string/glass_1" android:drawableTop="@drawable/ic_home" android:drawablePadding="4dp" android:paddingTop="8dp" />
                <TextView style="@style/NavItem" android:id="@+id/nav_transactions" android:text="@string/glass_2" android:drawableTop="@drawable/ic_transactions" android:drawablePadding="4dp" android:paddingTop="8dp" />
                <Button style="@style/PrimaryButton" android:id="@+id/nav_add" android:text="@string/glass_3" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center_vertical" android:layout_marginHorizontal="4dp" android:layout_marginVertical="0dp" android:padding="0dp" android:textSize="28sp" android:contentDescription="@string/add_transaction" />
                <TextView style="@style/NavItem" android:id="@+id/nav_summary" android:text="@string/summary_title" android:drawableTop="@drawable/ic_summary" android:drawablePadding="4dp" android:paddingTop="8dp" />
                <TextView style="@style/NavItem" android:id="@+id/nav_account" android:text="@string/glass_5" android:drawableTop="@drawable/ic_account" android:drawablePadding="4dp" android:paddingTop="8dp" />
            </LinearLayout>
        </vn.sotay.thuchi.BlurExcludedLayout>
    </FrameLayout>
</FrameLayout>
